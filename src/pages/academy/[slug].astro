---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n/cs';
import { getAcademyLessons, getRelatedMethods } from '../../lib/content';

export async function getStaticPaths() {
  const lessons = await getAcademyLessons();
  return lessons.map((lesson) => ({
    params: { slug: lesson.data.slug },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { data } = lesson;
const { Content } = await render(lesson);
const relatedMethods = await getRelatedMethods(data.relatedMethods);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.shortDescription,
  datePublished: data.publishedDate.toISOString(),
  dateModified: (data.updatedDate ?? data.publishedDate).toISOString(),
  inLanguage: 'cs',
};
---

<BaseLayout title={data.title} description={data.shortDescription} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <nav class="text-sm text-muted"><a href="/academy" class="hover:text-ink">{ui.academy.title}</a></nav>
    <span class="mt-3 inline-block rounded-full bg-bg px-2.5 py-1 text-xs font-semibold text-muted">
      {ui.academy.levels[data.level]}
    </span>
    <h1 class="mt-3 font-display text-3xl font-bold leading-tight sm:text-4xl">{data.title}</h1>
    <p class="mt-3 text-lg text-muted">{data.shortDescription}</p>

    <div class="prose-content mt-10 max-w-none text-ink [&_h2]:mt-8 [&_h2]:font-display [&_h2]:text-xl [&_h2]:font-bold [&_li]:mt-1 [&_ol]:mt-3 [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:mt-3 [&_p]:leading-relaxed [&_p]:text-muted [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:pl-5">
      <Content />
    </div>

    {relatedMethods.length > 0 && (
      <div class="mt-14 border-t border-border pt-8">
        <h2 class="font-display text-xl font-bold">Související možnosti vydělávání</h2>
        <ul class="mt-4 space-y-2">
          {relatedMethods.map((method) => (
            <li>
              <a href={`/moznosti/${method.data.slug}`} class="font-medium text-accent-dark hover:underline">
                {method.data.title} →
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </article>
</BaseLayout>
