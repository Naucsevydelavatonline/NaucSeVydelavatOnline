---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterBar from '../../components/FilterBar.astro';
import MethodCard from '../../components/MethodCard.astro';
import { ui } from '../../i18n/cs';
import { getCategories, getMethodsByCategory, getAcademyLessons, getScamAlerts } from '../../lib/content';

export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((category) => ({
    params: { category: category.data.id },
    props: { category },
  }));
}

const { category } = Astro.props;
const isAcademy = category.data.id === 'academy';
const isScamAlert = category.data.id === 'scam-alert';
const methods = isAcademy || isScamAlert ? [] : await getMethodsByCategory(category.data.id);
const academyLessons = isAcademy ? await getAcademyLessons() : [];
const scamAlerts = isScamAlert ? await getScamAlerts() : [];
const { Content: CategoryIntro } = await render(category);
---

<BaseLayout
  title={category.data.seoTitle ?? `${category.data.emoji} ${category.data.title}`}
  description={category.data.seoDescription ?? category.data.shortDescription}
  ogImage={category.data.ogImage}
  ogImageAlt={category.data.ogImageAlt}
  categoryId={category.data.id}
>
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class:list={["font-display text-4xl font-bold sm:text-5xl", { "text-red-700": isScamAlert }]}>
        {category.data.emoji} {category.data.title}
      </h1>
      <p class="mx-auto mt-3 max-w-xl text-muted">{category.data.shortDescription}</p>
    </div>

    <div class="mx-auto mt-8 max-w-2xl text-center text-sm leading-relaxed text-muted">
      <CategoryIntro />
    </div>

    {isAcademy && (
      <ul class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {academyLessons.map((lesson) => (
          <li>
            <a href={`/academy/${lesson.data.slug}`} class="block h-full rounded-2xl border border-border bg-card p-5 transition hover:-translate-y-0.5 hover:border-accent-dark hover:shadow-md">
              <span class="text-xs font-semibold uppercase tracking-wide text-muted">
                {ui.academy.levels[lesson.data.level]}
              </span>
              <p class="mt-2 font-display text-lg font-semibold">{lesson.data.title}</p>
              <p class="mt-2 text-sm text-muted">{lesson.data.shortDescription}</p>
            </a>
          </li>
        ))}
      </ul>
    )}

    {isScamAlert && (
      <ul class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {scamAlerts.map((alert) => (
          <li>
            <a href={`/scam-alert/${alert.data.slug}`} class="block h-full rounded-2xl border border-border bg-card p-5 transition hover:-translate-y-0.5 hover:border-red-300 hover:shadow-md">
              <span class="rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-700">
                {alert.data.scamType}
              </span>
              <p class="mt-3 font-display text-lg font-semibold">{alert.data.title}</p>
              <p class="mt-2 text-sm text-muted">{alert.data.shortDescription}</p>
            </a>
          </li>
        ))}
      </ul>
    )}

    {!isAcademy && !isScamAlert && (
      <div class="mt-10">
        <FilterBar categoryDefault={category.data.id}>
          {methods.map((method) => (
            <MethodCard method={method} />
          ))}
        </FilterBar>
      </div>
    )}
  </section>
</BaseLayout>
