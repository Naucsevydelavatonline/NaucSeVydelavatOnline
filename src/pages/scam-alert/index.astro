---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n/cs';
import { getScamAlerts } from '../../lib/content';

const alerts = await getScamAlerts();
---

<BaseLayout
  title={ui.scamAlert.title}
  description="Jak fungují nejčastější online podvody – falešné investice, phishing, fake e-shopy a další – a jak se před nimi chránit."
>
  <section class="border-b border-red-100 bg-red-50">
    <div class="mx-auto max-w-5xl px-4 py-16 text-center sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl font-bold text-red-700 sm:text-5xl">{ui.scamAlert.title}</h1>
      <p class="mx-auto mt-3 max-w-xl text-red-900/80">{ui.scamAlert.subtitle}</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      {alerts.map((alert) => (
        <li>
          <a
            href={`/scam-alert/${alert.data.slug}`}
            class="block h-full rounded-2xl border border-border bg-card p-5 transition hover:-translate-y-0.5 hover:border-red-300 hover:shadow-md"
          >
            <span class="rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-700">
              {alert.data.scamType}
            </span>
            <p class="mt-3 font-display text-lg font-semibold">{alert.data.title}</p>
            <p class="mt-2 text-sm text-muted">{alert.data.shortDescription}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
