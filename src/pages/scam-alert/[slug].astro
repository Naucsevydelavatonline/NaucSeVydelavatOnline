---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateLink from '../../components/AffiliateLink.astro';
import { ui } from '../../i18n/cs';
import { getScamAlerts } from '../../lib/content';

export async function getStaticPaths() {
  const alerts = await getScamAlerts();
  return alerts.map((alert) => ({
    params: { slug: alert.data.slug },
    props: { alert },
  }));
}

const { alert } = Astro.props;
const { data } = alert;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.shortDescription,
  datePublished: data.publishedDate.toISOString(),
  dateModified: (data.updatedDate ?? data.publishedDate).toISOString(),
  inLanguage: 'cs',
};
---

<BaseLayout title={data.title} description={data.shortDescription} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <nav class="text-sm text-muted"><a href="/scam-alert" class="hover:text-ink">{ui.scamAlert.title}</a></nav>
    <span class="mt-3 inline-block rounded-full bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-700">
      {data.scamType}
    </span>
    <h1 class="mt-3 font-display text-3xl font-bold leading-tight sm:text-4xl">{data.title}</h1>
    <p class="mt-3 text-lg text-muted">{data.shortDescription}</p>

    <div class="mt-10 space-y-8">
      <section>
        <h2 class="font-display text-xl font-bold">{ui.scamAlert.sections.howItWorks}</h2>
        <p class="mt-3 text-muted">{data.howItWorks}</p>
      </section>

      <section>
        <h2 class="font-display text-xl font-bold">{ui.scamAlert.sections.howVictimsAreLured}</h2>
        <p class="mt-3 text-muted">{data.howVictimsAreLured}</p>
      </section>

      <section class="rounded-2xl border border-red-200 bg-red-50 p-6">
        <h2 class="font-display text-xl font-bold text-red-700">{ui.scamAlert.sections.warningSigns}</h2>
        <ul class="mt-3 space-y-2">
          {data.warningSigns.map((sign) => (
            <li class="flex items-start gap-2 text-red-900">
              <span class="mt-0.5" aria-hidden="true">🚩</span>
              {sign}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-display text-xl font-bold">{ui.scamAlert.sections.howToVerify}</h2>
        <ul class="mt-3 space-y-2">
          {data.howToVerify.map((item) => (
            <li class="flex items-start gap-2 text-muted">
              <span class="mt-0.5 text-accent-dark" aria-hidden="true">✓</span>
              {item}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-display text-xl font-bold">{ui.scamAlert.sections.howToProtect}</h2>
        <ul class="mt-3 space-y-2">
          {data.howToProtect.map((item) => (
            <li class="flex items-start gap-2 text-muted">
              <span class="mt-0.5 text-accent-dark" aria-hidden="true">✓</span>
              {item}
            </li>
          ))}
        </ul>
      </section>

      {data.tools.length > 0 && (
        <section>
          <h2 class="font-display text-xl font-bold">{ui.scamAlert.sections.tools}</h2>
          <p class="mt-2 text-sm text-muted">
            Ne doporučení, abys tohle sám/sama dělal/a – jen ukázka, jak dostupné a přesvědčivé
            jsou obecné nástroje, kterými se podobný obsah v praxi vytváří.
          </p>
          <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            {data.tools.map((tool) => (
              <AffiliateLink toolId={tool.toolId} note={tool.note} />
            ))}
          </div>
        </section>
      )}

      <section>
        <h2 class="font-display text-xl font-bold">{ui.scamAlert.sections.whereToReport}</h2>
        <ul class="mt-3 space-y-2">
          {data.whereToReport.map((place) =>
            place.url ? (
              <li>
                <a href={place.url} target="_blank" rel="noopener" class="font-medium text-accent-dark hover:underline">
                  {place.name} →
                </a>
              </li>
            ) : (
              <li class="text-muted">{place.name}</li>
            )
          )}
        </ul>
      </section>

      {data.caseStudyNote && (
        <p class="border-t border-border pt-6 text-xs italic text-muted">
          {ui.scamAlert.caseStudyLabel}: {data.caseStudyNote}
        </p>
      )}
    </div>
  </article>
</BaseLayout>
