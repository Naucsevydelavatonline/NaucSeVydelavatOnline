---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterBar from '../components/FilterBar.astro';
import MethodCard from '../components/MethodCard.astro';
import { ui } from '../i18n/cs';
import { getCategories, getMobileOnlyMethods } from '../lib/content';

const categories = await getCategories();
const methods = await getMobileOnlyMethods();

const categoryLabels = new Map<string, string>();
for (const category of categories) {
  categoryLabels.set(category.data.id, `${category.data.emoji} ${category.data.title}`);
}
---

<BaseLayout
  title="📱 Mám jen mobil"
  description="Možnosti vydělávání online, na které si vystačíš jen s telefonem – bez počítače a bez velkých počátečních investic."
>
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="font-display text-4xl font-bold sm:text-5xl">{ui.mobileOnly.title}</h1>
      <p class="mx-auto mt-3 max-w-xl text-muted">{ui.mobileOnly.subtitle}</p>
    </div>

    <div class="mt-10">
      <FilterBar categories={categories} lockMobileOnly>
        {methods.map((method) => (
          <MethodCard method={method} categoryLabel={categoryLabels.get(method.data.category)} />
        ))}
      </FilterBar>
    </div>
  </section>
</BaseLayout>
