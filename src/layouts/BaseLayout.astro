---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n/cs';
import {
  resolveOgImage,
  resolveOgImageAlt,
  organizationJsonLd,
  websiteJsonLd,
  articleJsonLd,
  webPageJsonLd,
} from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /**
   * Předvyplněný JSON-LD uzel (nebo víc uzlů) pro TUTO stránku – typicky
   * `articleJsonLd(...)` z src/lib/seo.ts s reálnými daty publikace.
   * Když stránka nic nepošle, BaseLayout si automaticky vytvoří `WebPage`
   * (nebo minimální `Article`, jde-li o `ogType="article"`) z title/
   * description – stránka tak nikdy nezůstane bez structured data.
   * Globální `Organization` + `WebSite` uzly se přidávají vždy navíc,
   * nezávisle na tomhle proppu.
   */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Vlastní OG obrázek stránky/tutorialu (tier 1 fallbacku), pokud existuje. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Id kategorie (`categories.id`) pro tier-2 fallback OG obrázku. */
  categoryId?: string;
  /** tutorial / academy lekce / scam alert = 'article', vše ostatní (default) = 'website'. */
  ogType?: 'website' | 'article';
}

const { title, description, jsonLd, ogImage, ogImageAlt, categoryId, ogType = 'website' } = Astro.props;
const pageTitle = title === ui.siteName ? title : `${title} | ${ui.siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const resolvedOgImage = new URL(resolveOgImage({ ownImage: ogImage, categoryId }), Astro.site);
const resolvedOgImageAlt = resolveOgImageAlt({ ownAlt: ogImageAlt, categoryId });

// Structured data: globální Organization + WebSite vždy, k tomu buď
// stránkou dodaný jsonLd (Article s reálnými daty publikace...), nebo
// automaticky odvozený WebPage/Article fallback z title+description.
const pageJsonLdNodes = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [
      ogType === 'article'
        ? articleJsonLd({ headline: title, description })
        : webPageJsonLd({ name: pageTitle, description }),
    ];
const allJsonLd = [organizationJsonLd(Astro.site!), websiteJsonLd(Astro.site!), ...pageJsonLdNodes];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!--
      Favicon: SVG je hlavní zdroj pravdy (funguje ve všech aktuálních
      prohlížečích). PNG (32×32) a apple-touch-icon (180×180) jsou fallback
      pro starší prohlížeče a iOS home screen – soubory:
      public/favicon-32x32.png, public/apple-touch-icon.png.
    -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fafaf7" />

    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={ui.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />

    {allJsonLd.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} is:inline />
    ))}

    <script>
      import '../scripts/alpine.ts';
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-ink antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
