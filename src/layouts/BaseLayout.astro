---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { ui } from '../i18n/cs';
import {
  resolveOgImage,
  resolveOgImageAlt,
  organizationJsonLd,
  websiteJsonLd,
  articleJsonLd,
  webPageJsonLd,
} from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /**
   * Předvyplněný JSON-LD uzel (nebo víc uzlů) pro TUTO stránku – typicky
   * `articleJsonLd(...)` z src/lib/seo.ts s reálnými daty publikace.
   * Když stránka nic nepošle, BaseLayout si automaticky vytvoří `WebPage`
   * (nebo minimální `Article`, jde-li o `ogType="article"`) z title/
   * description – stránka tak nikdy nezůstane bez structured data.
   * Globální `Organization` + `WebSite` uzly se přidávají vždy navíc,
   * nezávisle na tomhle proppu.
   */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Vlastní OG obrázek stránky/tutorialu (tier 1 fallbacku), pokud existuje. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Id kategorie (`categories.id`) pro tier-2 fallback OG obrázku. */
  categoryId?: string;
  /** tutorial / academy lekce / scam alert = 'article', vše ostatní (default) = 'website'. */
  ogType?: 'website' | 'article';
}

const { title, description, jsonLd, ogImage, ogImageAlt, categoryId, ogType = 'website' } = Astro.props;
const pageTitle = title === ui.siteName ? title : `${title} | ${ui.siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const resolvedOgImage = new URL(resolveOgImage({ ownImage: ogImage, categoryId }), Astro.site);
const resolvedOgImageAlt = resolveOgImageAlt({ ownAlt: ogImageAlt, categoryId });

// Structured data: globální Organization + WebSite vždy, k tomu buď
// stránkou dodaný jsonLd (Article s reálnými daty publikace...), nebo
// automaticky odvozený WebPage/Article fallback z title+description.
const pageJsonLdNodes = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [
      ogType === 'article'
        ? articleJsonLd({ headline: title, description })
        : webPageJsonLd({ name: pageTitle, description }),
    ];
const allJsonLd = [organizationJsonLd(Astro.site!), websiteJsonLd(Astro.site!), ...pageJsonLdNodes];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!--
      Google Consent Mode v2: musí běžet PŘED načtením GTM. Výchozí stav je
      "zamítnuto" – analytické a marketingové cookies se uloží až po
      souhlasu v cookie liště (CookieBanner.astro). Pokud návštěvník už
      dříve rozhodl, jeho volbu aplikujeme hned, ať se neztratí první pageview.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      });
      try {
        var saved = JSON.parse(localStorage.getItem('cookie-consent') || 'null');
        if (saved) {
          gtag('consent', 'update', {
            analytics_storage: saved.analytics ? 'granted' : 'denied',
            ad_storage: saved.marketing ? 'granted' : 'denied',
            ad_user_data: saved.marketing ? 'granted' : 'denied',
            ad_personalization: saved.marketing ? 'granted' : 'denied'
          });
        }
      } catch (e) {}
    </script>

    <!-- Google Tag Manager (přes něj běží Google Analytics) -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-M925LPD4');
    </script>

    <!-- Ověření vlastnictví webu pro Impact (affiliate program DistroKid) -->
    <Fragment set:html="<meta name='impact-site-verification' value='c3dff213-8dd8-4277-a795-fafefa42609d'>" />

    <!--
      Favicon: SVG je hlavní zdroj pravdy (funguje ve všech aktuálních
      prohlížečích). PNG (32×32) a apple-touch-icon (180×180) jsou fallback
      pro starší prohlížeče a iOS home screen – soubory:
      public/favicon-32x32.png, public/apple-touch-icon.png.
    -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fafaf7" />

    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={ui.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />

    {allJsonLd.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} is:inline />
    ))}

    <script>
      import '../scripts/alpine.ts';
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-ink antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M925LPD4" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
