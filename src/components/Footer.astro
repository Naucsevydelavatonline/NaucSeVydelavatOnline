---
import { ui } from '../i18n/cs';
import { getCategories } from '../lib/content';
import { SITE_EMAIL } from '../lib/seo';

const categories = await getCategories();
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-card">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-4">
      <div>
        <p class="font-display text-lg font-bold">{ui.siteName}</p>
        <p class="mt-3 text-sm text-muted">{ui.footer.about}</p>
        <p class="mt-3 font-display text-sm font-semibold text-accent-dark">„{ui.tagline}“</p>

        <form x-data="{ email: '', sent: false }" @submit.prevent="sent = true" class="mt-5">
          <label for="footer-newsletter-email" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-muted">
            {ui.newsletter.title}
          </label>
          <div x-show="!sent" class="flex gap-2">
            <input
              id="footer-newsletter-email"
              type="email"
              required
              x-model="email"
              placeholder={ui.newsletter.placeholder}
              class="w-full min-w-0 rounded-full border border-border bg-bg px-3 py-2 text-xs text-ink placeholder:text-muted focus:border-accent-dark focus:outline-none"
            />
            <button
              type="submit"
              class="shrink-0 rounded-full bg-ink px-3 py-2 text-xs font-semibold text-white transition hover:bg-accent-dark hover:text-accent-ink"
            >
              {ui.newsletter.cta}
            </button>
          </div>
          <p x-cloak x-show="sent" class="text-xs text-muted">Díky! Dáme ti vědět. ✅</p>
        </form>
      </div>

      <div>
        <p class="text-sm font-semibold">{ui.nav.categories}</p>
        <ul class="mt-3 space-y-2">
          {categories.map((category) => (
            <li>
              <a href={`/kategorie/${category.data.id}`} class="text-sm text-muted hover:text-ink">
                {category.data.emoji} {category.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold">Web</p>
        <ul class="mt-3 space-y-2">
          <li><a href="/jak-chces-vydelavat" class="text-sm text-muted hover:text-ink">{ui.nav.cta}</a></li>
          <li><a href="/mam-jen-mobil" class="text-sm text-muted hover:text-ink">📱 Mám jen mobil</a></li>
          <li><a href="/academy" class="text-sm text-muted hover:text-ink">{ui.nav.academy}</a></li>
          <li><a href="/o-projektu" class="text-sm text-muted hover:text-ink">{ui.nav.about}</a></li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold">{ui.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          <li>
            <a href="/pravni/affiliate-disclosure" class="text-sm text-muted hover:text-ink">
              {ui.footer.affiliateDisclosure}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-border pt-6 text-xs text-muted">
      <p>
        Tento web obsahuje partnerské (affiliate) odkazy – více v sekci
        <a href="/pravni/affiliate-disclosure" class="underline hover:text-ink">{ui.footer.affiliateDisclosure}</a>.
      </p>
      <p class="mt-2">
        {ui.footer.contact}{' '}
        <a href={`mailto:${SITE_EMAIL}`} class="underline hover:text-ink">{SITE_EMAIL}</a>
      </p>
      <p class="mt-2">&copy; {year} {ui.siteName}. {ui.footer.rights}</p>
    </div>
  </div>
</footer>
