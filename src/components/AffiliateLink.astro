---
// Vykresluje odkaz na nástroj z centrálního affiliate registru
// (src/data/affiliate-links.ts). Dokud pro nástroj neexistuje aktivní
// partnerský odkaz, automaticky použije neafiliovaný fallbackUrl – obsah
// tak jde psát bez čekání na uzavřené partnerství.
import { getAffiliateTool } from '../data/affiliate-links';
import { ui } from '../i18n/cs';

interface Props {
  toolId: string;
  note?: string;
  class?: string;
}

const { toolId, note, class: className = '' } = Astro.props;
const tool = getAffiliateTool(toolId);
---

{tool && (
  <a
    href={tool.affiliateUrl ?? tool.fallbackUrl}
    target="_blank"
    rel={tool.affiliateUrl ? 'sponsored nofollow noopener' : 'noopener'}
    class={`group flex items-start justify-between gap-3 rounded-xl border border-border bg-card p-4 transition hover:border-accent-dark ${className}`}
  >
    <span>
      <span class="flex items-center gap-2 font-semibold">
        {tool.name}
        {tool.affiliateUrl && (
          <span class="text-xs font-normal text-muted">({ui.method.affiliateNote})</span>
        )}
      </span>
      <span class="mt-1 block text-sm text-muted">{note ?? tool.description}</span>
    </span>
    <svg
      class="mt-1 h-4 w-4 shrink-0 text-muted transition group-hover:text-accent-dark"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
    >
      <path d="M4 12l8-8M12 4H6M12 4v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
)}
