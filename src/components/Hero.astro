---
import { ui } from '../i18n/cs';
---

<section class="border-b border-border bg-card">
  <div class="mx-auto max-w-5xl px-4 py-16 text-center sm:px-6 sm:py-24 lg:px-8">
    <p class="inline-flex items-center gap-2 rounded-full bg-accent px-4 py-1.5 font-display text-sm font-semibold text-accent-ink">
      „{ui.tagline}“
    </p>
    <h1 class="mt-6 font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
      {ui.hero.title}
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-muted">{ui.hero.subtitle}</p>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/jak-chces-vydelavat"
        class="w-full rounded-full bg-ink px-6 py-3.5 text-center font-display text-base font-semibold text-white transition hover:bg-accent-dark hover:text-accent-ink sm:w-auto"
      >
        {ui.hero.ctaPrimary}
      </a>
      <a
        href="/mam-jen-mobil"
        class="w-full rounded-full border-2 border-ink px-6 py-3.5 text-center font-display text-base font-semibold text-ink transition hover:border-accent-dark hover:text-accent-dark sm:w-auto"
      >
        {ui.hero.ctaSecondary}
      </a>
    </div>

    <ul class="mx-auto mt-10 flex max-w-3xl flex-col flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-muted sm:flex-row">
      {ui.hero.trust.map((item) => (
        <li class="flex items-center gap-2">
          <span class="text-accent-dark" aria-hidden="true">✓</span>
          {item}
        </li>
      ))}
    </ul>
  </div>
</section>
