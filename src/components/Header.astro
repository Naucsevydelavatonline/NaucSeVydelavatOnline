---
import { ui } from '../i18n/cs';
import { getCategories } from '../lib/content';

const categories = await getCategories();
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur">
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
    x-data="{ menuOpen: false, catOpen: false }"
    @keydown.escape="menuOpen = false; catOpen = false"
  >
    <a href="/" class="font-display text-lg font-bold tracking-tight sm:text-xl">
      Nauč se <span class="text-accent-dark">vydělávat</span> online
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-6 md:flex">
      <div class="relative" @mouseleave="catOpen = false">
        <button
          type="button"
          class="flex items-center gap-1 text-sm font-medium text-ink hover:text-accent-dark"
          @click="catOpen = !catOpen"
          @mouseenter="catOpen = true"
          aria-haspopup="true"
          :aria-expanded="catOpen"
        >
          {ui.nav.categories}
          <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
        <div
          x-cloak
          x-show="catOpen"
          x-transition
          class="absolute left-0 top-full grid w-64 grid-cols-1 gap-1 rounded-xl border border-border bg-card p-2 shadow-lg"
        >
          {categories.map((category) => (
            <a
              href={`/kategorie/${category.data.id}`}
              class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-bg"
            >
              <span aria-hidden="true">{category.data.emoji}</span>
              {category.data.title}
            </a>
          ))}
        </div>
      </div>

      <a href="/academy" class="text-sm font-medium text-ink hover:text-accent-dark">{ui.nav.academy}</a>
      <a href="/o-projektu" class="text-sm font-medium text-ink hover:text-accent-dark">{ui.nav.about}</a>
      <a href="/o-projektu#pribeh" class="text-sm font-semibold text-accent-dark hover:underline">{ui.nav.shareStory}</a>
      <a
        href="/jak-chces-vydelavat"
        class="rounded-full bg-ink px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent-dark hover:text-accent-ink"
      >
        {ui.nav.cta}
      </a>
    </nav>

    <!-- Mobile toggle -->
    <button
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-lg border border-border md:hidden"
      @click="menuOpen = !menuOpen"
      aria-label="Otevřít menu"
      :aria-expanded="menuOpen"
    >
      <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>

    <!-- Mobile menu -->
    <div
      x-cloak
      x-show="menuOpen"
      x-transition
      class="absolute inset-x-0 top-full z-50 border-b border-border bg-bg px-4 pb-6 pt-2 shadow-lg md:hidden"
    >
      <a href="/jak-chces-vydelavat" class="block rounded-full bg-ink px-4 py-3 text-center text-sm font-semibold text-white">
        {ui.nav.cta}
      </a>
      <a href="/mam-jen-mobil" class="mt-3 block rounded-full border border-border px-4 py-3 text-center text-sm font-semibold">
        📱 Mám jen mobil
      </a>

      <p class="mt-6 px-1 text-xs font-semibold uppercase tracking-wide text-muted">{ui.nav.categories}</p>
      <div class="mt-2 grid grid-cols-2 gap-2">
        {categories.map((category) => (
          <a href={`/kategorie/${category.data.id}`} class="rounded-lg border border-border px-3 py-2 text-sm">
            {category.data.emoji} {category.data.title}
          </a>
        ))}
      </div>

      <div class="mt-6 flex flex-col gap-2 border-t border-border pt-4">
        <a href="/academy" class="text-sm font-medium">{ui.nav.academy}</a>
        <a href="/o-projektu" class="text-sm font-medium">{ui.nav.about}</a>
        <a href="/o-projektu#pribeh" class="text-sm font-semibold text-accent-dark">{ui.nav.shareStory}</a>
      </div>
    </div>
  </div>
</header>
