---
import type { CollectionEntry } from 'astro:content';
import MobileOnlyBadge from './MobileOnlyBadge.astro';
import { startupCostLabel, difficultyLabel, formatIncomeRange } from '../lib/labels';

interface Props {
  method: CollectionEntry<'methods'>;
  categoryLabel?: string;
}

const { method, categoryLabel } = Astro.props;
const { data } = method;
---

<a
  href={`/moznosti/${data.slug}`}
  data-method-card
  data-categories={[data.category, ...data.secondaryCategories].join(' ')}
  data-cost={data.startupCost}
  data-difficulty={data.difficulty}
  data-mobile-only={data.mobileOnly ? 'true' : 'false'}
  class="flex h-full flex-col justify-between rounded-2xl border border-border bg-card p-5 transition hover:-translate-y-0.5 hover:border-accent-dark hover:shadow-md"
>
  <div>
    <div class="flex flex-wrap items-center gap-2">
      {categoryLabel && (
        <span class="rounded-full bg-bg px-2.5 py-1 text-xs font-medium text-muted">{categoryLabel}</span>
      )}
      {data.mobileOnly && <MobileOnlyBadge />}
    </div>
    <h3 class="mt-3 font-display text-lg font-semibold leading-snug">{data.title}</h3>
    <p class="mt-2 text-sm text-muted">{data.shortDescription}</p>
  </div>

  <div class="mt-4 flex flex-wrap gap-2 text-xs">
    <span class="rounded-full border border-border px-2.5 py-1">{difficultyLabel(data.difficulty)}</span>
    <span class="rounded-full border border-border px-2.5 py-1">{startupCostLabel(data.startupCost)}</span>
  </div>

  <p class="mt-4 font-display text-sm font-semibold text-accent-dark">
    {formatIncomeRange(data.incomePotential.min, data.incomePotential.max, data.incomePotential.period)}
  </p>
</a>
